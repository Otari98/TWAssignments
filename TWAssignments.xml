<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Script file="TWAssignments.lua"/>
    <Frame name="TWRow" virtual="true">
        <Size x="590" y="20"/>
        <Anchors>
            <Anchor point="TOP"/>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" tile="true"/>
        <Frames>
            <Button name="$parentCloseRow" inherits="UIPanelCloseButton">
                <Size x="22" y="22"/>
                <Anchors>
                    <Anchor point="RIGHT">
                        <Offset x="3" y="0"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TWA.RemoveRow_OnClick(this:GetID())
                        CloseDropDownMenus()
                    </OnClick>
                    <OnEnter>
                        TWA.Cell_OnEnter(this:GetID())
                    </OnEnter>
                    <OnLeave>
                        TWA.Cell_OnLeave(this:GetID())
                    </OnLeave>
                </Scripts>
            </Button>
        </Frames>
    </Frame>
    <Button name="TWCell" virtual="true">
        <Size x="80" y="20"/>
        <Anchors>
            <Anchor point="LEFT"/>
        </Anchors>
        <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" tile="true"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentText" inherits="GameFontNormal">
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset x="5" y="0"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <Texture name="$parentIcon" file="Interface\TargetingFrame\UI-RaidTargetingIcons">
                    <Size x="12" y="12"/>
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset x="-4" y="0"/>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>
                TWA.Cell_OnClick(this:GetID())
            </OnClick>
            <OnEnter>
                TWA.Cell_OnEnter(this:GetID())
            </OnEnter>
            <OnLeave>
                TWA.Cell_OnLeave(this:GetID())
            </OnLeave>
        </Scripts>
    </Button>
    <Frame name="TWA_Main" hidden="true" toplevel="true" parent="UIParent" movable="true" enableMouse="true">
        <Size x="605" y="100"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="false">
            <BackgroundInsets left="5" right="5" top="5" bottom="5"/>
            <EdgeSize val="18"/>
            <BorderColor r="0.8" g="0.8" b="0.8" a="1"/>
        </Backdrop>
        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentText" inherits="GameFontNormal" text=" -- TARGET --">
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset x="5" y="-30"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentText" inherits="GameFontNormal" text=" ----------------- TANKS -------------------">
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset x="90" y="-30"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentText" inherits="GameFontNormal" text="  -------------------- HEALERS ------------------">
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset x="330" y="-30"/>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="TWA_Minimap" movable="true" parent="Minimap" enableMouse="true" toplevel="true">
                <Size x="33" y="33"/>
                <Anchors>
                    <Anchor point="CENTER"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture file="Interface\Icons\Spell_Holy_Heal02">
                            <Size x="21" y="21"/>
                            <Anchors>
                                <Anchor point="TOPLEFT">
                                    <Offset x="7" y="-6"/>
                                </Anchor>
                            </Anchors>
                            <TexCoords left="0.075" right="0.925" top="0.075" bottom="0.925"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture file="Interface\Minimap\MiniMap-TrackingBorder">
                            <Size x="56" y="56"/>
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <HighlightTexture alphaMode="ADD" file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight"/>
                <Scripts>
                    <OnLoad>
                        this:RegisterForClicks("RightButtonUp")
                        this:RegisterForDrag("LeftButton")
                        this:SetClampedToScreen(true)
                    </OnLoad>
                    <OnDragStart>
                        this:LockHighlight()
                        this:StartMoving()
                    </OnDragStart>
                    <OnDragStop>
                        this:UnlockHighlight()
                        this:StopMovingOrSizing()
                        TWA_POSITION = {this:GetCenter()}
                    </OnDragStop>
                    <OnEnter>
                        GameTooltip:SetOwner(this, "ANCHOR_TOPLEFT", 0, 0)
                        GameTooltip:AddLine('TWAssignments', 1, 1, 1)
                        GameTooltip:AddLine('Left-click to toggle frame')
                        GameTooltip:Show()
                    </OnEnter>
                    <OnLeave>
                        GameTooltip:Hide()
                    </OnLeave>
                    <OnMouseUp>
                        if TWA_Main:IsShown() then
                            HideUIPanel(TWA_Main)
                        else
                            ShowUIPanel(TWA_Main)
                        end
                        CloseDropDownMenus()
                    </OnMouseUp>
                </Scripts>
            </Button>
            <Button name="$parentClose" inherits="UIPanelCloseButton">
                <Size x="32" y="32"/>
                <Anchors>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        HideUIPanel(TWA_Main)
                        CloseDropDownMenus()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentAddLine" inherits="UIPanelButtonTemplate2" text="+">
                <Size x="30" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset x="5" y="-5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TWA.AddLine_OnClick()
                        CloseDropDownMenus()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentReset" inherits="UIPanelButtonTemplate2" text="Reset">
                <Size x="80" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset x="-30" y="-5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TWA.Reset_OnClick()
                        CloseDropDownMenus()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentAnnounce" inherits="UIPanelButtonTemplate2" text="Announce">
                <Size x="120" y="20"/>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset x="85" y="-5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TWA.Announce_OnClick()
                        CloseDropDownMenus()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentTemplates" inherits="UIPanelButtonTemplate2" text="Templates">
                <Size x="100" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset x="-120" y="-5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TWA.Templates_OnClick()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentSavePreset" inherits="UIPanelButtonTemplate2" text="Save">
                <Size x="60" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset x="-230" y="-5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TWA.SavePreset_OnClick()
                        CloseDropDownMenus()
                    </OnClick>
                </Scripts>
            </Button>
            <Button name="$parentLoadPreset" inherits="UIPanelButtonTemplate2" text="Load">
                <Size x="60" y="20"/>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset x="-290" y="-5"/>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        TWA.LoadPreset_OnClick()
                        CloseDropDownMenus()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>
                TWA.OnLoad()
            </OnLoad>
            <OnEvent>
                TWA[event]()
            </OnEvent>
            <OnDragStart>
                this:StartMoving()
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing()
            </OnDragStop>
            <OnMouseUp>
				CloseDropDownMenus()
			</OnMouseUp>
        </Scripts>
    </Frame>
</Ui>
